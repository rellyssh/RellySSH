{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.rellyssh",
  "productName": "Terminal RellySSH",
  "directories": {
    "output": "dist-release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/node-pty/**/*",
    "**/node_modules/argon2/**/*"
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] },
      { "target": "rpm", "arch": ["x64"] }
    ],
    "category": "System;TerminalEmulator;Network;Utility;Development;",
    "maintainer": "RellySSH Team <support@rellyssh.io>",
    "synopsis": "Emulador de terminal y cliente SSH seguro de código abierto con bóveda cifrada",
    "desktop": {
      "entry": {
        "Name": "Terminal RellySSH",
        "GenericName": "Terminal SSH",
        "Comment": "Terminal SSH segura y multiplataforma con bóveda cifrada",
        "Keywords": "terminal;console;ssh;remote;shell;command;prompt;rellyssh;term;emulador;",
        "Categories": "System;TerminalEmulator;Network;Utility;Development;"
      }
    }
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "category": "public.app-category.developer-tools"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
